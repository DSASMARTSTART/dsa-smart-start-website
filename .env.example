# DSA Smart Start Environment Variables
# ======================================
# Copy this file to .env and fill in your values

# Admin Configuration
VITE_ADMIN_EMAIL=your-admin-email@example.com

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Raiffeisen RaiAccept Payment Configuration (Card Payments)
# Set RAIACCEPT_API_USERNAME and RAIACCEPT_API_PASSWORD as Supabase Edge Function secrets:
#   supabase secrets set RAIACCEPT_API_USERNAME=your_username RAIACCEPT_API_PASSWORD=your_password
VITE_RAIACCEPT_ENABLED=true

# Raiffeisen/UPC Installment Payments (optional second card rail)
# Frontend flag only; server credentials/certificates must be set as Supabase Edge Function secrets.
VITE_RAIFFEISEN_INSTALLMENTS_ENABLED=false
#
# Supabase Edge Function secrets required before enabling installments:
#   RAIFFEISEN_UPC_MERCHANT_ID=your_merchant_id
#   RAIFFEISEN_UPC_TERMINAL_ID=your_terminal_id
#   RAIFFEISEN_UPC_GATEWAY_URL=https://bank-hosted-payment-url
#   RAIFFEISEN_UPC_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----..."
#   RAIFFEISEN_UPC_SERVER_CERT_PEM="-----BEGIN CERTIFICATE-----..."
# Optional, confirm exact values with the bank:
#   RAIFFEISEN_UPC_CURRENCY_CODE=941
#   RAIFFEISEN_UPC_SIGNATURE_HASH=SHA-1
#   RAIFFEISEN_UPC_EUR_TO_RSD_RATE=117.15
#   RAIFFEISEN_UPC_AMOUNT_MULTIPLIER=100

# PayPal Configuration
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
VITE_PAYPAL_MODE=sandbox

# Stripe Configuration (if used)
VITE_STRIPE_PUBLIC_KEY=your-stripe-public-key
